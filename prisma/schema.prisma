// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// MARK: USER
model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String // Hashed
  name       String?
  role       Role     @default(viewer)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum Role {
  admin
  editor
  viewer
}

// MARK: HOME
model Home {
  id                  String   @id @default(uuid())
  profile             String   @unique
  hero_image          String?  @default("/images/placeholder.png")
  featured_product    Product? @relation(fields: [featured_product_id], references: [id], onDelete: SetNull)
  featured_product_id String?  @unique
  featured_image      String?
  featured_features   Json[]
  quote               Json?
  partners            String[]
}

// MARK: FAQ
model Faq {
  id String  @id @default(uuid())
  q  String
  a  String?
}

// MARK: PRODUCTS
model Product {
  id          String          @id @default(uuid())
  model       String          @unique
  title       String
  price       Float?
  description String?
  images      String[]
  features    Json?
  specs       Json?
  Category    Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  category_id String?
  media       ProductMedia[]
  reviews     ProductReview[]
  Home        Home?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  @@index(model)
}

model Category {
  id          String    @id @default(uuid())
  title       String    @unique
  banner      String?
  title_en    String?
  description String?
  products    Product[]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model ProductMedia {
  id         String   @id @default(uuid())
  title      String?
  subtitle   String?
  media_url  String?
  style      Style    @default(image_bottom)
  Product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ProductReview {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  image      String?
  author     String   @default("Ẩn danh")
  Product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum Style {
  image_only
  image_left
  image_right
  image_bottom
}

// MARK: ARTICLES
model Topic {
  id         String    @id @default(uuid())
  title      String    @unique
  articles   Article[]
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Article {
  id          String   @id @default(uuid())
  title       String
  author      String   @default("Ẩn danh")
  banner      String?
  description String?
  content     Json?
  Topic       Topic?   @relation(fields: [topic_id], references: [id], onDelete: SetNull)
  topic_id    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// MARK: AGENCIES
model Agency {
  id         String   @id @default(uuid())
  title      String
  image      String?
  lat        Decimal?
  lng        Decimal?
  location   String?
  phone      String?  @unique
  email      String?  @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([lat, lng])
}
